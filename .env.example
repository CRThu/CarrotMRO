# 使用说明：复制此文件为 .env 并填入实际值
# cp .env.example .env
# 后端启动时会自动加载项目根目录的 .env 文件

# ===== litellm OCR 配置 =====
# 模型名称（litellm 格式：provider/model-name）
LITELLM_MODEL=xiaomi_mimo/mimo-v2-flash

# API Key（从 https://platform.xiaomimimo.com 获取）
XIAOMI_MIMO_API_KEY=你的API_KEY

# ===== 代理配置（按需取消注释）=====
# PROXY=http://127.0.0.1:7890

# ===== 数据目录配置（默认基于项目根目录自动定位，一般无需修改）=====
# 数据根目录
#DATA_ROOT=data

# 项目数据子目录 (位于 DATA_ROOT 下)
#PROJECT_SUBDIR=projects

# 模板文件子目录 (位于 DATA_ROOT 下)
#TEMPLATE_SUBDIR=template
