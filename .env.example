# ===== Google Gemini API 配置 =====
# 从 https://aistudio.google.com/app/apikey 获取
GEMINI_API_KEY=你的API_KEY

# 使用的模型
GEMINI_MODEL=gemini-3.1-flash-lite

# ===== 代理配置（按需取消注释）=====
# PROXY=http://127.0.0.1:7890

# ===== 识别提示词与结构配置 =====
# 提示词：你可以通过环境变量覆盖默认的通用工程报价单识别指令
#GEMINI_PROMPT="你是一个专业的工程报价单OCR识别助手。你的任务是读取并理解图片中的工程报价单，将其转换为JSON格式。要求：提取项目名称、数量、单位、参考单价；不要包含项目序号；不要虚构项目；将不确定的内容备注在remarks字段。"

# JSON结构：指定输出的格式
#GEMINI_JSON_SCHEMA='{"items": [{"name": "string", "quantity": "number/string", "unit": "string", "unit_price": "number/null"}], "remarks": "string"}'

# 数据根目录
DATA_ROOT=data

# 项目数据子目录 (位于 DATA_ROOT 下)
PROJECT_SUBDIR=project

# 模板文件子目录 (位于 DATA_ROOT 下)
TEMPLATE_SUBDIR=template
